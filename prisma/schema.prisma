generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = "mysql://root:5hBg4g5HFHf3BBceAAgD-6ac1-4gBdE4@viaduct.proxy.rlwy.net:15525/railway"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  nip          String
  division     String
  email        String   @unique
  password     String
  phone_number String
  address      String
  role         String   @default("employee")
  status       String   @default("alpha")
  reports      Report[]
}

model DailyRecapt {
  id           Int      @id @default(autoincrement())
  name         String
  nip          String
  division     String
  email        String   @unique
  password     String
  phone_number String
  address      String
  role         String
  status       String
  reports      Report[]
}

model Report {
  id            Int         @id @default(autoincrement())
  description   String
  type          ReportType
  createdBy     User        @relation(fields: [createdById], references: [id])
  createdById   Int
  createdAt     String
  image         String
  dailyRecapt   DailyRecapt @relation(fields: [dailyRecaptId], references: [id])
  dailyRecaptId Int
}

enum ReportType {
  HARIAN
  MINGGUAN
  BULANAN
}
