// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id           Int            @id @default(autoincrement())
  name         String
  nip          String
  division     String
  email        String         @unique
  password     String
  phone_number String
  address      String
  role         String         @default("employee")
  status       String         @default("alpha")
  reports      Report[]
  recap        DailyRecap[]
  monthly      MonthlyRecap[]
}

model Report {
  id             Int           @id @default(autoincrement())
  kms            String
  description    String
  type           ReportType
  createdBy      User          @relation(fields: [createdById], references: [id])
  createdById    Int
  createdAt      String
  image          String
  DailyRecap     DailyRecap?   @relation(fields: [dailyRecapId], references: [id])
  dailyRecapId   Int?
  monthlyRecap   MonthlyRecap? @relation(fields: [monthlyRecapId], references: [id])
  monthlyRecapId Int?
}

model DailyRecap {
  id           Int      @id @default(autoincrement())
  name         String
  nip          String
  division     String
  email        String
  password     String
  phone_number String
  address      String
  role         String
  status       String
  days         String
  recapType    String
  User         User?    @relation(fields: [userId], references: [id])
  userId       Int?
  report       Report[]
}

model MonthlyRecap {
  id           Int      @id @default(autoincrement())
  name         String
  nip          String
  division     String
  email        String
  password     String
  phone_number String
  address      String
  role         String
  status       String
  days         String
  recapType    String
  User         User?    @relation(fields: [userId], references: [id])
  userId       Int?
  report       Report[]
}

enum ReportType {
  HARIAN
  MINGGUAN
  BULANAN
}
