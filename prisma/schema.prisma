// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  nip          String
  division     String
  email        String        @unique
  password     String
  phone_number String
  address      String
  role         String        @default("employee")
  status       String        @default("alpha")
  reports      Report[]
  daily        DailyRecapt[]
}

model Report {
  id            Int          @id @default(autoincrement())
  description   String
  type          ReportType
  createdBy     User         @relation(fields: [createdById], references: [id])
  createdById   Int
  createdAt     String
  image         String
  DailyRecapt   DailyRecapt? @relation(fields: [dailyRecaptId], references: [id])
  dailyRecaptId Int?
}

model DailyRecapt {
  id           Int      @id @default(autoincrement())
  name         String
  nip          String
  division     String
  email        String   @unique
  password     String
  phone_number String
  address      String
  role         String
  status       String
  User         User?    @relation(fields: [userId], references: [id])
  userId       Int?
  report       Report[]
}

enum ReportType {
  HARIAN
  MINGGUAN
  BULANAN
}
